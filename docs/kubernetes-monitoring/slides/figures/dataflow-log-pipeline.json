  "flows": [
    {
      "id": "stdout-write",
      "from": "app",
      "to": "logfile",
      "label": "JSON 라인",
      "classification": "앱 로그",
      "variant": "emphasis"
    },
    {
      "id": "tail-read",
      "from": "logfile",
      "to": "alloy",
      "label": "tail",
      "classification": "노드 로컬 읽기",
      "variant": "emphasis"
    },
    {
      "id": "push-loki",
      "from": "alloy",
      "to": "loki",
      "label": "push + 라벨",
