        "note": "같은 시간축에 메트릭 그래프와 로그를 놓는 것이 목적지다."
      }
    ]
  },
  "stages": [
    {
      "label": "발생"
    },
    {
      "label": "노드 기록"
    },
    {
      "label": "수집"
    },
    {
      "label": "저장"
    },
    {
      "label": "조회"
    }
  ],
  "nodes": [
    {
      "id": "app",
      "type": "backend",
      "label": "앱 컨테이너",
