      "row": 1,
      "tag": "청크 저장"
    },
    {
      "id": "prometheus",
      "type": "database",
      "label": "Prometheus",
      "sublabel": "메트릭 시계열",
      "stage": 3,
      "row": 3,
      "tag": "별도 경로"
    },
    {
      "id": "grafana",
      "type": "frontend",
      "label": "Grafana",
      "sublabel": "Explore · 대시보드",
      "stage": 4,
      "row": 2
    }
