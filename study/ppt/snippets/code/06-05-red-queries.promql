# R — 초당 요청 수
sum by (service) (rate(http_server_requests_seconds_count{namespace="apps"}[5m]))

# E — 5xx 비율. 표본이 없을 때를 대비해 or vector(0)
sum(rate(http_server_requests_seconds_count{status=~"5.."}[5m]))
  / sum(rate(http_server_requests_seconds_count[5m])) or vector(0)

# D — P95. sum by (le) 로 파드별 버킷을 먼저 합친 뒤 계산한다
histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))
